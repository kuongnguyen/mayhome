[Unit]
Description=MAYHOME CENTER fixed read-only status collector

[Service]
Type=oneshot
User=root
Group=mayhome-center
WorkingDirectory=/opt/mayhome-center
ExecStart=/opt/mayhome-center/.venv/bin/python -I -m mayhome_center.collector
RuntimeDirectory=mayhome-center
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/mayhome-center
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
UMask=0027
TimeoutStartSec=75
MemoryMax=150M
CPUQuota=100%
